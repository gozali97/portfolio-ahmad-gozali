NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/dashboard

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portofolio
DB_USERNAME=root
DB_PASSWORD=
# Set to true for managed/cloud MySQL that requires TLS (PlanetScale, TiDB, Aiven, etc.)
DB_SSL=false
# Set to false if the DB user cannot run CREATE DATABASE (most hosted providers)
DB_CREATE_DATABASE=true

# Folder penyimpanan file upload admin (default: ./storage/uploads)
UPLOAD_DIR=
